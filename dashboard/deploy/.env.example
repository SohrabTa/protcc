# Copy to .env and change what you need. Every value here is optional.
#
# The port the site answers on.
PORT=8080
# The address it answers on. 127.0.0.1 is for a reverse proxy on the same host. Use 0.0.0.0 only
# when the proxy runs on another machine.
BIND_ADDRESS=127.0.0.1
# The Zenodo record. data-release.json names it, so set this only to override that file.
ZENODO_RECORD=
